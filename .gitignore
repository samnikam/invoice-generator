# ── Dependencies ────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.pnpm-store/

# ── Next.js build output ────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Tests and coverage ──────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ── Environment files (may contain secrets) ─────────────────
# Every .env file is ignored. Only the placeholder template is committed.
.env
.env.*
!.env.example

# ── Secrets and keys ────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Lockfiles from other package managers (this project uses pnpm only)
package-lock.json
yarn.lock
bun.lockb
bun.lock

# ── OS / editor files ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# ── Deployment platforms ────────────────────────────────────
.vercel
