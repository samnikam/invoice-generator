# SmartBill environment variables — TEMPLATE ONLY.
#
# Copy this file to `.env.local` and fill in real values there.
# Never put real secrets in this file: it is committed to Git.
# `.env.local` is ignored by Git.

# Public URL of the app (used for absolute links and metadata).
# Safe to expose to the browser because of the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000

